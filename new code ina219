// ================================================================
// SETUP
// ================================================================

void setup()
{
    Serial.begin(
        115200
    );


    delay(1000);


    // ============================================================
    // GPIO
    // ============================================================

    pinMode(
        RELAY_PIN,
        OUTPUT
    );


    pinMode(
        RED_LED_PIN,
        OUTPUT
    );


    pinMode(
        GREEN_LED_PIN,
        OUTPUT
    );


    pinMode(
        BLUE_LED_PIN,
        OUTPUT
    );


    pinMode(
        BUTTON_UP_PIN,
        INPUT_PULLUP
    );


    pinMode(
        BUTTON_DOWN_PIN,
        INPUT_PULLUP
    );


    pinMode(
        TEMP_PIN,
        INPUT
    );


    // ============================================================
    // OUTPUTS OFF
    // ============================================================

    allOutputsOff();


    // ============================================================
    // ESP32 ADC
    // ============================================================

    analogReadResolution(
        12
    );


    analogSetPinAttenuation(
        TEMP_PIN,
        ADC_11db
    );


    // ============================================================
    // I2C
    // ============================================================

    Wire.begin(
        SDA_PIN,
        SCL_PIN
    );


    // ============================================================
    // LCD
    // ============================================================

    lcd.init();

    lcd.backlight();

    lcd.clear();


    lcd.setCursor(
        0,
        0
    );

    lcd.print(
        "SMART BATTERY"
    );


    lcd.setCursor(
        0,
        1
    );

    lcd.print(
        "3S3P SYSTEM"
    );


    delay(2000);


    // ============================================================
    // INA219
    // ============================================================

    ina219Connected =
        initializeINA219();


    // ============================================================
    // INA219 ERROR
    // ============================================================

    if (!ina219Connected)
    {
        lcd.clear();


        lcd.setCursor(
            0,
            0
        );

        lcd.print(
            "INA219 ERROR"
        );


        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "CHECK WIRING"
        );


        setRelay(false);


        setLED(
            BLUE_LED_PIN,
            true
        );


        while (true)
        {
            delay(1000);
        }
    }


    // ============================================================
    // SYSTEM READY
    // ============================================================

    lcd.clear();


    lcd.setCursor(
        0,
        0
    );

    lcd.print(
        "SYSTEM READY"
    );


    lcd.setCursor(
        0,
        1
    );

    lcd.print(
        "INA219 OK"
    );


    delay(1500);


    // ============================================================
    // TIMERS
    // ============================================================

    lastSensorMillis =
        millis();

    lastLCDMillis =
        millis();

    lastSerialMillis =
        millis();

    lastPageMillis =
        millis();
}


// ================================================================
// LOOP
// ================================================================

void loop()
{
    unsigned long now =
        millis();


    // ============================================================
    // BUTTONS
    // ============================================================

    handleButtons();


    // ============================================================
    // SENSOR UPDATE
    // ============================================================

    if (
        now -
        lastSensorMillis
        >=
        SENSOR_INTERVAL_MS
    )
    {
        lastSensorMillis =
            now;


        // --------------------------------------------------------
        // INA219
        // --------------------------------------------------------

        readINA219();


        // --------------------------------------------------------
        // TEMPERATURE
        // --------------------------------------------------------

        batteryTemperature =
            readTemperature();


        // --------------------------------------------------------
        // SOC
        // --------------------------------------------------------

        batterySOC =
            calculateSOC(
                batteryVoltage
            );


        // --------------------------------------------------------
        // FAULTS
        // --------------------------------------------------------

        updateFaults();


        // --------------------------------------------------------
        // CHARGING CONTROL
        // --------------------------------------------------------

        controlCharging();


        // --------------------------------------------------------
        // LEDs
        // --------------------------------------------------------

        updateLEDs();
    }


    // ============================================================
    // LCD PAGE CHANGE
    // ============================================================

    if (
        now -
        lastPageMillis
        >=
        LCD_PAGE_INTERVAL_MS
    )
    {
        lastPageMillis =
            now;


        lcdPage++;


        if (
            lcdPage > 3
        )
        {
            lcdPage = 0;
        }
    }


    // ============================================================
    // LCD UPDATE
    // ============================================================

    if (
        now -
        lastLCDMillis
        >=
        LCD_INTERVAL_MS
    )
    {
        lastLCDMillis =
            now;


        updateLCD();
    }


    // ============================================================
    // SERIAL UPDATE
    // ============================================================

    if (
        now -
        lastSerialMillis
        >=
        SERIAL_INTERVAL_MS
    )
    {
        lastSerialMillis =
            now;


        printSerial();
    }
}
