/*
================================================================
       SMART 3S3P BATTERY MONITORING & CHARGING CUTOFF
       ESP32 + INA219 + LCD + POT + RELAY + LEDs
================================================================

BATTERY:
  Configuration : 3S3P
  Nominal       : 11.1 V
  Full charge   : 12.6 V
  Capacity      : 10.5 Ah

INA219:
  Voltage : Battery voltage
  Current : Charging current
  Power   : V x I

TEMPERATURE:
  10K potentiometer
  Wiper -> GPIO 32

LCD:
  16x2 I2C
  Address 0x27

RELAY:
  GPIO 4

BUTTONS:
  UP   -> GPIO 33
  DOWN -> GPIO 14

LEDs:
  RED   -> GPIO 25 = Charging
  GREEN -> GPIO 26 = Complete
  BLUE  -> GPIO 27 = Fault

I2C:
  SDA -> GPIO 21
  SCL -> GPIO 22
================================================================
*/


