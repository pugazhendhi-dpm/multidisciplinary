// ================================================================
// OUTPUT FUNCTION
// ================================================================

void writeOutput(
    uint8_t pin,
    bool state,
    bool activeHigh
)
{
    bool level =
        activeHigh ? state : !state;

    digitalWrite(
        pin,
        level ? HIGH : LOW
    );
}


// ================================================================
// RELAY
// ================================================================

void setRelay(bool state)
{
    writeOutput(
        RELAY_PIN,
        state,
        !RELAY_ACTIVE_LOW
    );
}


// ================================================================
// LED
// ================================================================

void setLED(
    uint8_t pin,
    bool state
)
{
    writeOutput(
        pin,
        state,
        LED_ACTIVE_HIGH
    );
}


// ================================================================
// ALL OUTPUTS OFF
// ================================================================

void allOutputsOff()
{
    setRelay(false);

    setLED(
        RED_LED_PIN,
        false
    );

    setLED(
        GREEN_LED_PIN,
        false
    );

    setLED(
        BLUE_LED_PIN,
        false
    );
}


// ================================================================
// INA219 INITIALIZATION
// ================================================================

bool initializeINA219()
{
    Serial.println();
    Serial.println(
        "=============================="
    );

    Serial.println(
        "INITIALIZING INA219"
    );

    Serial.println(
        "=============================="
    );


    if (!ina219.begin())
    {
        Serial.println(
            "INA219 NOT FOUND"
        );

        Serial.println(
            "Check SDA GPIO21"
        );

        Serial.println(
            "Check SCL GPIO22"
        );

        Serial.println(
            "Check VCC"
        );

        Serial.println(
            "Check GND"
        );

        return false;
    }


    // --------------------------------------------------------
    // 32V / 2A CALIBRATION
    // --------------------------------------------------------

    ina219.setCalibration_32V_2A();


    Serial.println(
        "INA219 FOUND"
    );

    Serial.println(
        "Calibration: 32V / 2A"
    );

    Serial.print(
        "Current calibration: "
    );

    Serial.println(
        CURRENT_CALIBRATION,
        4
    );

    Serial.print(
        "Voltage offset: "
    );

    Serial.print(
        VOLTAGE_OFFSET_V,
        3
    );

    Serial.println(
        " V"
    );


    return true;
}


// ================================================================
// READ INA219
// ================================================================

void readINA219()
{
    if (!ina219Connected)
    {
        batteryVoltage = 0.0f;

        chargingCurrentA = 0.0f;

        chargingCurrentmA = 0.0f;

        chargingPowerW = 0.0f;

        return;
    }


    float voltageSum = 0.0f;

    float currentSum_mA = 0.0f;

    float shuntSum_mV = 0.0f;


    // --------------------------------------------------------
    // MULTIPLE INA219 READINGS
    // --------------------------------------------------------

    for (
        uint8_t i = 0;
        i < INA_SAMPLES;
        i++
    )
    {
        voltageSum +=
            ina219.getBusVoltage_V();


        currentSum_mA +=
            ina219.getCurrent_mA();


        shuntSum_mV +=
            ina219.getShuntVoltage_mV();


        delay(5);
    }


    // --------------------------------------------------------
    // AVERAGE
    // --------------------------------------------------------

    float busVoltage =
        voltageSum /
        INA_SAMPLES;


    float current_mA =
        currentSum_mA /
        INA_SAMPLES;


    float shunt_mV =
        shuntSum_mV /
        INA_SAMPLES;


    // --------------------------------------------------------
    // SAVE RAW VALUES
    // --------------------------------------------------------

    rawBusVoltage =
        busVoltage;

    rawShuntVoltage_mV =
        shunt_mV;

    rawCurrentmA =
        current_mA;


    // --------------------------------------------------------
    // CURRENT
    // --------------------------------------------------------

    float measuredCurrentA =
        current_mA / 1000.0f;


    measuredCurrentA *=
        CURRENT_DIRECTION;


    measuredCurrentA =
        (
            measuredCurrentA *
            CURRENT_CALIBRATION
        )
        +
        CURRENT_OFFSET_A;


    // --------------------------------------------------------
    // FOR CHARGING DISPLAY
    // USE POSITIVE CURRENT
    // --------------------------------------------------------

    measuredCurrentA =
        fabs(measuredCurrentA);


    // --------------------------------------------------------
    // REMOVE VERY SMALL CURRENT
    // --------------------------------------------------------

    if (
        measuredCurrentA <
        CURRENT_ZERO_THRESHOLD_A
    )
    {
        measuredCurrentA = 0.0f;
    }


    // --------------------------------------------------------
    // BATTERY VOLTAGE
    // --------------------------------------------------------

    float shuntVoltageV =
        shunt_mV / 1000.0f;


    // --------------------------------------------------------
    // VOLTAGE CALIBRATION
    // --------------------------------------------------------
    //
    // Original:
    //
    // measuredVoltage = busVoltage + shuntVoltageV;
    //
    // Corrected:
    //
    // measuredVoltage =
    //     busVoltage +
    //     shuntVoltageV +
    //     VOLTAGE_OFFSET_V;
    //
    // --------------------------------------------------------

    float measuredVoltage =
        busVoltage +
        shuntVoltageV +
        VOLTAGE_OFFSET_V;


    // --------------------------------------------------------
    // VOLTAGE FILTER
    // --------------------------------------------------------

    if (
        filteredVoltage < 0.01f
    )
    {
        filteredVoltage =
            measuredVoltage;
    }
    else
    {
        filteredVoltage =
            (
                filteredVoltage *
                0.90f
            )
            +
            (
                measuredVoltage *
                0.10f
            );
    }


    // --------------------------------------------------------
    // CURRENT FILTER
    // --------------------------------------------------------

    if (
        filteredCurrentA < 0.001f
    )
    {
        filteredCurrentA =
            measuredCurrentA;
    }
    else
    {
        filteredCurrentA =
            (
                filteredCurrentA *
                0.80f
            )
            +
            (
                measuredCurrentA *
                0.20f
            );
    }


    // --------------------------------------------------------
    // FINAL VALUES
    // --------------------------------------------------------

    batteryVoltage =
        filteredVoltage;


    chargingCurrentA =
        filteredCurrentA;


    // --------------------------------------------------------
    // CONVERT A -> mA
    // --------------------------------------------------------

    chargingCurrentmA =
        chargingCurrentA *
        1000.0f;


    // --------------------------------------------------------
    // POWER
    // --------------------------------------------------------

    chargingPowerW =
        batteryVoltage *
        chargingCurrentA;
}


// ================================================================
// TEMPERATURE POTENTIOMETER
// ================================================================

float readTemperature()
{
    uint32_t adcTotal = 0;


    for (
        uint8_t i = 0;
        i < TEMP_SAMPLES;
        i++
    )
    {
        adcTotal +=
            analogRead(
                TEMP_PIN
            );

        delayMicroseconds(500);
    }


    float adc =
        (
            float
        )
        adcTotal /
        TEMP_SAMPLES;


    // --------------------------------------------------------
    // LIMIT ADC
    // --------------------------------------------------------

    if (adc < 0.0f)
        adc = 0.0f;


    if (adc > 4095.0f)
        adc = 4095.0f;


    // --------------------------------------------------------
    // ADC -> TEMPERATURE
    // --------------------------------------------------------

    float temperature =
        TEMP_MIN_C
        +
        (
            adc / 4095.0f
        )
        *
        (
            TEMP_MAX_C -
            TEMP_MIN_C
        );


    return temperature;
}


// ================================================================
// SOC CALCULATION
// ================================================================

int calculateSOC(
    float voltage
)
{
    float soc;


    if (voltage >= 12.60f)
    {
        soc = 100.0f;
    }

    else if (voltage >= 12.40f)
    {
        soc =
            90.0f
            +
            (
                (
                    voltage -
                    12.40f
                )
                /
                0.20f
            )
            *
            10.0f;
    }

    else if (voltage >= 12.20f)
    {
        soc =
            80.0f
            +
            (
                (
                    voltage -
                    12.20f
                )
                /
                0.20f
            )
            *
            10.0f;
    }

    else if (voltage >= 12.00f)
    {
        soc =
            65.0f
            +
            (
                (
                    voltage -
                    12.00f
                )
                /
                0.20f
            )
            *
            15.0f;
    }

    else if (voltage >= 11.70f)
    {
        soc =
            45.0f
            +
            (
                (
                    voltage -
                    11.70f
                )
                /
                0.30f
            )
            *
            20.0f;
    }

    else if (voltage >= 11.40f)
    {
        soc =
            25.0f
            +
            (
                (
                    voltage -
                    11.40f
                )
                /
                0.30f
            )
            *
            20.0f;
    }

    else if (voltage >= 11.10f)
    {
        soc =
            15.0f
            +
            (
                (
                    voltage -
                    11.10f
                )
                /
                0.30f
            )
            *
            10.0f;
    }

    else if (voltage >= 10.50f)
    {
        soc =
            5.0f
            +
            (
                (
                    voltage -
                    10.50f
                )
                /
                0.60f
            )
            *
            10.0f;
    }

    else if (voltage >= 9.00f)
    {
        soc =
            (
                (
                    voltage -
                    9.00f
                )
                /
                1.50f
            )
            *
            5.0f;
    }

    else
    {
        soc = 0.0f;
    }


    soc =
        constrain(
            soc,
            0.0f,
            100.0f
        );


    return (int)
        roundf(soc);
}


// ================================================================
// UPDATE FAULTS
// ================================================================

void updateFaults()
{
    // --------------------------------------------------------
    // INA219
    // --------------------------------------------------------

    sensorFault =
        !ina219Connected;


    // --------------------------------------------------------
    // VOLTAGE VALIDATION
    // --------------------------------------------------------

    if (
        isnan(batteryVoltage) ||
        batteryVoltage <
        MIN_VALID_VOLTAGE ||
        batteryVoltage >
        MAX_VALID_VOLTAGE
    )
    {
        sensorFault = true;
    }


    // --------------------------------------------------------
    // CURRENT VALIDATION
    // --------------------------------------------------------

    if (
        isnan(chargingCurrentA)
    )
    {
        sensorFault = true;
    }


    // --------------------------------------------------------
    // TEMPERATURE
    // --------------------------------------------------------

    if (
        isnan(batteryTemperature)
    )
    {
        sensorFault = true;
    }


    // --------------------------------------------------------
    // OVER VOLTAGE
    // --------------------------------------------------------

    overVoltageFault =
        batteryVoltage >=
        OVER_VOLTAGE_LIMIT;


    // --------------------------------------------------------
    // LOW VOLTAGE
    // --------------------------------------------------------

    lowVoltageFault =
        batteryVoltage <=
        LOW_VOLTAGE_LIMIT;


    // --------------------------------------------------------
    // OVER CURRENT
    // --------------------------------------------------------

    overCurrentFault =
        chargingCurrentA >=
        MAX_CHARGE_CURRENT_A;


    // --------------------------------------------------------
    // HIGH TEMPERATURE
    // --------------------------------------------------------

    highTemperatureFault =
        batteryTemperature >=
        MAX_BATTERY_TEMPERATURE_C;


    // --------------------------------------------------------
    // MASTER FAULT
    // --------------------------------------------------------

    masterFault =
        sensorFault
        ||
        overVoltageFault
        ||
        overCurrentFault
        ||
        highTemperatureFault;
}


// ================================================================
// FAULT MESSAGE
// ================================================================

const char* getFaultMessage()
{
    if (sensorFault)
        return "SENSOR FAULT";

    if (overVoltageFault)
        return "OVER VOLTAGE";

    if (overCurrentFault)
        return "OVER CURRENT";

    if (highTemperatureFault)
        return "HIGH TEMP";

    if (lowVoltageFault)
        return "LOW BATTERY";

    return "NO FAULT";
}


// ================================================================
// CHARGING CONTROL
// ================================================================

void controlCharging()
{
    // --------------------------------------------------------
    // SAFETY FAULT
    // --------------------------------------------------------

    if (masterFault)
    {
        chargingActive =
            false;

        chargingComplete =
            false;

        setRelay(false);

        return;
    }


    // --------------------------------------------------------
    // SOC CUTOFF
    // --------------------------------------------------------

    if (
        batterySOC >=
        cutoffSOC
    )
    {
        chargingActive =
            false;

        chargingComplete =
            true;

        setRelay(false);

        return;
    }


    // --------------------------------------------------------
    // 12.6 V FULL CHARGE CUTOFF
    // --------------------------------------------------------

    if (
        batteryVoltage >=
        BATTERY_FULL_VOLTAGE
    )
    {
        chargingActive =
            false;

        chargingComplete =
            true;

        setRelay(false);

        return;
    }


    // --------------------------------------------------------
    // NORMAL CHARGING
    // --------------------------------------------------------

    chargingActive =
        true;

    chargingComplete =
        false;

    setRelay(true);
}


// ================================================================
// LED CONTROL
// ================================================================

void updateLEDs()
{
    setLED(
        RED_LED_PIN,
        false
    );

    setLED(
        GREEN_LED_PIN,
        false
    );

    setLED(
        BLUE_LED_PIN,
        false
    );


    // Fault
    if (masterFault)
    {
        setLED(
            BLUE_LED_PIN,
            true
        );

        return;
    }


    // Complete
    if (chargingComplete)
    {
        setLED(
            GREEN_LED_PIN,
            true
        );

        return;
    }


    // Charging
    if (chargingActive)
    {
        setLED(
            RED_LED_PIN,
            true
        );
    }
}


// ================================================================
// BUTTON CONTROL
// ================================================================

void handleButtons()
{
    unsigned long now =
        millis();


    if (
        now -
        lastButtonMillis
        <
        BUTTON_DEBOUNCE_MS
    )
    {
        return;
    }


    bool upPressed =
        digitalRead(
            BUTTON_UP_PIN
        ) == LOW;


    bool downPressed =
        digitalRead(
            BUTTON_DOWN_PIN
        ) == LOW;


    // --------------------------------------------------------
    // UP
    // --------------------------------------------------------

    if (
        upPressed &&
        !downPressed
    )
    {
        cutoffSOC +=
            CUTOFF_STEP;


        if (
            cutoffSOC >
            MAX_CUTOFF_SOC
        )
        {
            cutoffSOC =
                MAX_CUTOFF_SOC;
        }


        if (
            batterySOC <
            cutoffSOC
        )
        {
            chargingComplete =
                false;
        }


        lastButtonMillis =
            now;


        Serial.print(
            "Cutoff = "
        );

        Serial.print(
            cutoffSOC
        );

        Serial.println(
            "%"
        );
    }


    // --------------------------------------------------------
    // DOWN
    // --------------------------------------------------------

    if (
        downPressed &&
        !upPressed
    )
    {
        cutoffSOC -=
            CUTOFF_STEP;


        if (
            cutoffSOC <
            MIN_CUTOFF_SOC
        )
        {
            cutoffSOC =
                MIN_CUTOFF_SOC;
        }


        if (
            batterySOC <
            cutoffSOC
        )
        {
            chargingComplete =
                false;
        }


        lastButtonMillis =
            now;


        Serial.print(
            "Cutoff = "
        );

        Serial.print(
            cutoffSOC
        );

        Serial.println(
            "%"
        );
    }
}


// ================================================================
// LCD DISPLAY - NO BLINKING
// ================================================================

void updateLCD()
{
    // --------------------------------------------------------
    // FAULT
    // --------------------------------------------------------

    if (masterFault)
    {
        lcd.setCursor(
            0,
            0
        );

        if (sensorFault)
            lcd.print("SENSOR FAULT   ");

        else if (overVoltageFault)
            lcd.print("OVER VOLTAGE   ");

        else if (overCurrentFault)
            lcd.print("OVER CURRENT   ");

        else if (highTemperatureFault)
            lcd.print("HIGH TEMP      ");

        else if (lowVoltageFault)
            lcd.print("LOW BATTERY    ");

        else
            lcd.print("FAULT          ");


        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "CHARGER OFF    "
        );

        return;
    }


    // --------------------------------------------------------
    // COMPLETE
    // --------------------------------------------------------

    if (chargingComplete)
    {
        lcd.setCursor(
            0,
            0
        );

        lcd.print(
            "CHARGE COMPLETE"
        );


        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "SOC : "
        );

        lcd.print(
            batterySOC
        );

        lcd.print(
            " %          "
        );

        return;
    }


    // ========================================================
    // PAGE 0
    // VOLTAGE + CURRENT
    // ========================================================

    if (
        lcdPage == 0
    )
    {
        lcd.setCursor(
            0,
            0
        );

        lcd.print(
            "V : "
        );

        lcd.print(
            batteryVoltage,
            2
        );

        lcd.print(
            " V     "
        );


        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "I : "
        );

        lcd.print(
            chargingCurrentmA,
            0
        );

        lcd.print(
            " mA    "
        );

        return;
    }


    // ========================================================
    // PAGE 1
    // POWER + SOC
    // ========================================================

    if (
        lcdPage == 1
    )
    {
        lcd.setCursor(
            0,
            0
        );

        lcd.print(
            "P : "
        );

        lcd.print(
            chargingPowerW,
            1
        );

        lcd.print(
            " W      "
        );


        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "SOC : "
        );

        lcd.print(
            batterySOC
        );

        lcd.print(
            " %       "
        );

        return;
    }


    // ========================================================
    // PAGE 2
    // SOC + SOH
    // ========================================================

    if (
        lcdPage == 2
    )
    {
        lcd.setCursor(
            0,
            0
        );

        lcd.print(
            "SOC : "
        );

        lcd.print(
            batterySOC
        );

        lcd.print(
            " %       "
        );


        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "SOH : "
        );

        lcd.print(
            batterySOH
        );

        lcd.print(
            " %       "
        );

        return;
    }


    // ========================================================
    // PAGE 3
    // TEMPERATURE + CUTOFF
    // ========================================================

    if (
        lcdPage == 3
    )
    {
        lcd.setCursor(
            0,
            0
        );

        lcd.print(
            "TEMP : "
        );

        lcd.print(
            batteryTemperature,
            1
        );

        lcd.print(
            " C    "
        );


        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "CUT : "
        );

        lcd.print(
            cutoffSOC
        );

        lcd.print(
            " %       "
        );

        return;
    }
}


